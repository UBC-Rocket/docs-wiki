# Copy to .env on the server (never commit .env).

# Public hostname. Its DNS A record must point at the instance's reserved IP
# BEFORE you start the stack, or Caddy can't get a certificate.
WIKI_DOMAIN=docs.ubcrocket.com

# Database password. Generate one with:  openssl rand -base64 24
DB_PASS=change-me

# First admin account (used once, on first start). Use a team address if possible.
ADMIN_EMAIL=
# Generate one with:  openssl rand -base64 18
ADMIN_PASS=change-me
